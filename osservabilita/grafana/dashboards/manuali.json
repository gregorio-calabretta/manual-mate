{
  "uid": "manuali-auto",
  "title": "Assistente manuali auto",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Richieste per esito",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "manuali-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (esito) (manuali_richieste_total)", "legendFormat": "{{esito}}"}]
    },
    {
      "id": 2,
      "title": "Latenza media end-to-end · ultimi 5 minuti",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "manuali-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "rate(manuali_latenza_secondi_sum[5m]) / rate(manuali_latenza_secondi_count[5m])", "legendFormat": "Latenza media"}]
    },
    {
      "id": 3,
      "title": "Chiamate agli strumenti",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "manuali-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (tool) (manuali_tool_total)", "legendFormat": "{{tool}}"}]
    }
  ]
}
